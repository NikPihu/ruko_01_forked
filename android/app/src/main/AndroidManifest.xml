<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Context signals, read by signals/ContextSensor.kt (guide step 6). Each runtime
         permission is asked for only when the matching Scam Shield consent is on. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />
    <!-- Demo build only: Play does not allow SMS access for a payment app. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Background task-scam watcher (shield/): bank SMS alerts wake the app; warnings are notifications. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <!-- Remote access apps. Confirm each package name on its Play Store page before the finale. -->
        <package android:name="com.anydesk.anydeskandroid" />
        <package android:name="com.teamviewer.quicksupport.market" />
        <package android:name="com.carriez.flutter_hbb" /> <!-- RustDesk -->
        <package android:name="com.sand.airdroid" />
        <!-- Launcher apps, so a freshly sideloaded "support" app is visible for sideload_last_24h -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ruko">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ships disabled; ShieldController enables it when "Watch my money alerts" is on. -->
        <receiver
            android:name=".shield.SmsReceiver"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- "Check chat messages": reads chat app notifications on the phone; Android asks the
             user for notification access in Settings before it runs. -->
        <service
            android:name=".shield.ChatListener"
            android:exported="true"
            android:label="@string/consent_chat"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
